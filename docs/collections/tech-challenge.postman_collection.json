          "name": "Approve budget",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{baseUrl}}/client/service-orders/{{service_order_code}}/budget/approve?document_number={{cpf}}",
              "host": ["{{baseUrl}}"],
              "path": ["client", "service-orders", "{{service_order_code}}", "budget", "approve"],
              "query": [{ "key": "document_number", "value": "{{cpf}}" }]
            }
          }
        },
        {
          "name": "Reject budget",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Muito caro, vou pensar melhor\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/client/service-orders/{{service_order_code}}/budget/reject?document_number={{cpf}}",
              "host": ["{{baseUrl}}"],
              "path": ["client", "service-orders", "{{service_order_code}}", "budget", "reject"],
              "query": [{ "key": "document_number", "value": "{{cpf}}" }]
            }
          }
        }
      ]
    }
  ]
